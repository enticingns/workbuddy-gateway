# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 与 CHANGELOG.md 必须进版本库）
# defaultprompt.md 是 go:embed 资源（internal/prompt），必须进版本库，否则 CI 编译失败
*.md
!README.md
!CHANGELOG.md
!internal/prompt/defaultprompt.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store

# 真机抓包产物（含请求体、请求头、账号标识、本地 CA 私钥——绝不入库）
tools/wb-capture/captures/
tools/wb-capture/captures_mitm/
tools/wb-capture/ca/
tools/wb-capture/proxy.log*
tools/wb-capture/*.log
tools/wb-capture/*.dump
tools/wb-capture/*.err
tools/wb-capture/*.out
tools/wb-capture/product.capture*.json
tools/wb-capture/product.orig.json
tools/wb-capture/*.bak-orig
tools/wb-capture/profile*.json
tools/wb-capture/identity-verify-result.json
